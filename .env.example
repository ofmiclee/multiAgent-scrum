# Local account development only. Never use these settings for a public server.
MAS_IDENTITY_PORT=4399
MAS_IDENTITY_LOCAL_MAIL=1
# Generate a private 32-byte hex secret once using the README command.
# MAS_IDENTITY_SECRET=

# Optional GitHub OAuth for your own local development application.
# Callback URL: http://127.0.0.1:4399/api/identity/callback/github
# MAS_GITHUB_CLIENT_ID=
# MAS_GITHUB_CLIENT_SECRET=

# Native task execution is disabled unless explicitly enabled and authorized.
# ENABLE_ACCOUNT_RUNNER_TASKS=1
# ENABLE_ACCOUNT_RUNNER_CODEX_TASKS=1
# ENABLE_ACCOUNT_RUNNER_EXECUTION=1

# Optional local Runner task assessment. Keep real credentials private.
# MAS_TASK_ASSESSOR=typesafe
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
